    "@codemirror/view": "6.43.9",
    "@element-plus/icons-vue": "^2.3.2",
    "@milkdown/crepe": "7.22.1",
    "@milkdown/kit": "7.22.1",
    "@milkdown/plugin-block": "^7.22.0",
    "@milkdown/plugin-cursor": "^7.22.0",
    "@milkdown/plugin-history": "^7.22.0",
    "@milkdown/plugin-listener": "^7.22.0",
