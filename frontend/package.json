    "codemirror": "^6.0.0",
    "dompurify": "^3.4.14",
    "fflate": "^0.8.3",
    "katex": "0.18.4",
    "marked": "^15.0.0",
    "mermaid": "^11.17.2",
    "pinia": "^4.0.0",
    "semver": "^7.8.5",
    "shiki": "^4.4.3",
