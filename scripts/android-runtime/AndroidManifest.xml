<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="cc.kronecker.opennexus.testdriver">
    <uses-sdk android:minSdkVersion="24" android:targetSdkVersion="36" />
    <queries><package android:name="cc.kronecker.opennexus.dev" /></queries>
    <application android:label="OpenNexus CI driver" android:allowBackup="false" android:debuggable="true">
        <service android:name=".CompositionIme" android:label="OpenNexus CI Chinese composition"
            android:permission="android.permission.BIND_INPUT_METHOD" android:exported="true">
            <intent-filter><action android:name="android.view.InputMethod" /></intent-filter>
            <meta-data android:name="android.view.im" android:resource="@xml/ci_input_method" />
        </service>
    </application>
    <instrumentation android:name="cc.kronecker.opennexus.testdriver.RuntimeProbe" android:targetPackage="cc.kronecker.opennexus.testdriver" android:functionalTest="false" />
</manifest>
